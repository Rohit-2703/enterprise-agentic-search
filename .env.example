# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Pinecone Configuration
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=enterprise-search
PINECONE_DIMENSION=3072

# LangSmith Configuration (Optional but Recommended for Tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=enterprise-search
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enterprise_search
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/enterprise_search

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

LOG_LEVEL=INFO


# Cache Configuration
REDIS_CACHE_TTL=3600
POSTGRES_CACHE_TTL=604800
ENABLE_CACHING=true

# Agent Configuration
CONFIDENCE_THRESHOLD=0.7
MAX_RETRIES=2
ENABLE_SELF_HEALING=true
ENABLE_QUERY_DECOMPOSITION=true
MIN_SIMILARITY_SCORE=0.6

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# GitHub MCP Configuration (Optional - for GitHub MCP client)
GITHUB_API_TOKEN=your-github-personal-access-token-here
GITHUB_ORGANIZATION=your-organization-name

# JIRA MCP Configuration (Optional - for JIRA MCP client)
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token-here